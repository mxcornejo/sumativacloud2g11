{
  "info": {
    "name": "EFT S9 · Video paso a paso · Usuarios y Roles",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "24 solicitudes para grabación manual. Configurar eftBffUrl con el BFF EFT desplegado. Ejecutar en orden y repetir solamente las consultas de espera 04, 11, 15 y 22. No ejecutar como Runner continuo sin controlar esas esperas. IDs se guardan automáticamente para ver-auditoria.sh. Se crean solo entidades con prefijo EFT. No contiene claves."
  },
  "variable": [
    {
      "key": "eftBffUrl",
      "value": "http://44.210.30.141"
    }
  ],
  "item": [
    {
      "name": "01 · BFF health e iniciar una demostración nueva",
      "request": {
        "method": "GET",
        "url": "{{eftBffUrl}}/api/health",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Ejecutar una vez al comenzar. Genera nombres/correos únicos y limpia los IDs de la ejecución previa. No repetir durante la demostración."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tag='EFT_'+pm.variables.replaceIn('{{$guid}}').replace(/-/g,'').slice(0,10); pm.collectionVariables.set('tag',tag); pm.collectionVariables.set('email',tag.toLowerCase()+'@example.test'); pm.collectionVariables.set('gqlEmail',tag.toLowerCase()+'g@example.test'); ['userId','roleId','gqlUserId','gqlRoleId','defaultRoleId'].forEach(k=>pm.collectionVariables.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Identificar rol por defecto",
      "request": {
        "method": "GET",
        "url": "{{eftBffUrl}}/api/roles",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const r=pm.response.json().find(x=>x.name==='EFT_USUARIO' && x.active); pm.test('EFT_USUARIO existe',()=>pm.expect(r).to.exist); if(!r) throw new Error('Falta desplegar la migración EFT'); pm.collectionVariables.set('defaultRoleId',String(r.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · REST crear usuario sin rol",
